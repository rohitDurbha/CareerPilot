# Copy this file to meet/.env.local for local development, or set the same
# variables on your host (for example in the Vercel project settings).

# LiveKit server settings. These are read only by the API routes on the server.
# Never prefix the key or secret with NEXT_PUBLIC_, because Next.js copies every
# NEXT_PUBLIC_ variable into the JavaScript that ships to the browser.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Address of the CareerPilot Flask backend. This one is safe to expose.
NEXT_PUBLIC_CAREERPILOT_API_URL=http://localhost:5001

# Optional extras from the LiveKit Meet template.
# NEXT_PUBLIC_SHOW_SETTINGS_MENU=true
# NEXT_PUBLIC_LK_RECORD_ENDPOINT=/api/record
# S3_KEY_ID=
# S3_KEY_SECRET=
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=

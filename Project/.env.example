# Copy this file to Project/.env and fill in your own values.
# Project/.env is ignored by git, so real passwords never get committed.

# MongoDB connection string. A free MongoDB Atlas M0 cluster works.
# Leave it unset to use a local MongoDB on mongodb://localhost:27017.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=scrapped_jobs
MONGO_COLLECTION=Careerpilot

# Activepieces webhook that starts the job search flow.
# The /trigger and /upload_resume routes both post to it.
ACTIVEPIECES_JOB_SEARCH_WEBHOOK=https://cloud.activepieces.com/api/v1/webhooks/<flow-id>

# Activepieces webhook that scores the resume against the jobs it found.
ACTIVEPIECES_RESUME_MATCH_WEBHOOK=https://cloud.activepieces.com/api/v1/webhooks/<flow-id>

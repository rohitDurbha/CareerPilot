{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo No packages to install for the static pages",
  "buildCommand": "node scripts/build-site.mjs",
  "outputDirectory": "site",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "Project/**",
      "excludeFiles": "{meet,interview_agent,tests,site}/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/api", "destination": "/api/index" }
  ]
}

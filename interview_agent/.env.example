# LiveKit Cloud project credentials (both agents)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Groq free tier key for the interviewer: Whisper (whisper-large-v3-turbo) for
# speech to text, GPT-OSS 20B (openai/gpt-oss-20b) for replies and Orpheus
# (canopylabs/orpheus-v1-english, voice autumn) for its voice. Groq publishes
# these Developer plan base limits, and the free tier is never higher:
#   openai/gpt-oss-20b             30 RPM, 1,000 RPD, 8,000 TPM, 200,000 TPD
#   whisper-large-v3-turbo         20 RPM, 2,000 RPD, 7,200 audio s/hour, 28,800 audio s/day
#   canopylabs/orpheus-v1-english  10 RPM, 100 RPD, 1,200 TPM, 3,600 TPD, 200 characters per request
GROQ_API_KEY=

# How many interviews a day share those limits (default 2). Each interview gets
# an equal share of 80% of the daily limits and closes politely before using it.
# With the default, one interview may make 40 Orpheus requests and speak 4,320
# characters. If the free tier numbers at https://console.groq.com/settings/limits
# are lower than the ones above, raise this number so each share shrinks.
CAREERPILOT_INTERVIEWS_PER_DAY=2

# Speech to text for the transcriber agent
DEEPGRAM_API_KEY=
